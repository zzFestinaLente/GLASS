{
  "common": {
    "dataset": "topic_writing_temporal",
    "model_path": "${GLASS_MODEL}",
    "device": "cuda:0"
  },
  "prepare": {
    "raw_dir": "${GLASS_DATA}/topic_writing_temporal/raw",
    "train_output": "${GLASS_RUN}/topic_writing_temporal/train.pkl",
    "test_output": "${GLASS_RUN}/topic_writing_temporal/test.pkl",
    "threshold": 200,
    "seed": 42
  },
  "cluster": {
    "train_input": "${GLASS_RUN}/topic_writing_temporal/train.pkl",
    "test_input": "${GLASS_RUN}/topic_writing_temporal/test.pkl",
    "clusters_output": "${GLASS_RUN}/topic_writing_temporal/clusters.json",
    "train_output": "${GLASS_RUN}/topic_writing_temporal/anchors.pkl",
    "test_output": "${GLASS_RUN}/topic_writing_temporal/test_clusters.pkl",
    "seed": 42,
    "num_workers": 1
  },
  "global": {
    "input_path": "${GLASS_RUN}/topic_writing_temporal/train.pkl",
    "output_path": "${GLASS_RUN}/topic_writing_temporal/global.pt",
    "sae_model_path": "${GLASS_SAE}",
    "global_layer": 19,
    "max_profile_samples": 20,
    "max_length": 512
  },
  "rank": {
    "input_path": "${GLASS_RUN}/topic_writing_temporal/anchors.pkl",
    "output_path": "${GLASS_RUN}/topic_writing_temporal/ranked.json",
    "global_vectors_path": "${GLASS_RUN}/topic_writing_temporal/global.pt",
    "global_layer": 19,
    "global_strength": 0.5,
    "batch_size": 2,
    "max_new_tokens": 400
  },
  "pairs": {
    "input_path": "${GLASS_RUN}/topic_writing_temporal/anchors.pkl",
    "ranked_path": "${GLASS_RUN}/topic_writing_temporal/ranked.json",
    "output_path": "${GLASS_RUN}/topic_writing_temporal/accepted.json",
    "error_output_path": "${GLASS_RUN}/topic_writing_temporal/rejected.json",
    "global_vectors_path": "${GLASS_RUN}/topic_writing_temporal/global.pt",
    "global_layer": 19,
    "global_strength": 0.4,
    "batch_size": 2,
    "max_new_tokens": 400,
    "k": 3,
    "num_negatives": 3,
    "seed": 42,
    "min_gain": 0
  },
  "local": {
    "input_path": "${GLASS_RUN}/topic_writing_temporal/accepted.json",
    "output_path": "${GLASS_RUN}/topic_writing_temporal/local",
    "global_vectors_path": "${GLASS_RUN}/topic_writing_temporal/global.pt",
    "global_layer": 19,
    "local_layer": 23,
    "priming_strength": 0.1
  },
  "generate": {
    "input_path": "${GLASS_RUN}/topic_writing_temporal/test_clusters.pkl",
    "output_path": "${GLASS_RUN}/topic_writing_temporal/generation.json",
    "global_vectors_path": "${GLASS_RUN}/topic_writing_temporal/global.pt",
    "local_vectors_path": "${GLASS_RUN}/topic_writing_temporal/local",
    "global_layer": 19,
    "local_layer": 23,
    "global_strength": 0.4,
    "local_strength": 0.7,
    "max_new_tokens": 400
  },
  "evaluate": {
    "input_path": "${GLASS_RUN}/topic_writing_temporal/generation.json",
    "output_path": "${GLASS_RUN}/topic_writing_temporal/metrics.json",
    "meteor": false
  }
}
